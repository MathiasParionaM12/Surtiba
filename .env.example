# Modelo de variables de entorno. Este archivo SÍ se sube a GitHub, así que aquí nunca van claves reales.
# Copia este archivo como .env.local (ese NO se sube) y llena los valores.
# Están en Supabase -> Project Settings -> API (o API Keys).

# URL del proyecto, ej. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública: "anon" o "publishable" (empieza con eyJ... o con sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta "service_role": todavía no hace falta. Solo para el servidor, jamás en el navegador.
# SUPABASE_SERVICE_ROLE_KEY=
